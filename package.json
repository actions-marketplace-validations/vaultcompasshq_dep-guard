{
  "name": "@vaultcompass/dep-guard-monorepo",
  "version": "0.6.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/cli",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc -b packages/core packages/cli && tsc --noEmit -p tsconfig.test.json",
    "lint": "pnpm check:public-hygiene",
    "check:public-hygiene": "node scripts/check-public-hygiene.mjs",
    "bootstrap:npm": "bash scripts/bootstrap-npm-packages.sh",
    "corpus:build": "node scripts/build-corpus.mjs",
    "corpus:refresh": "node scripts/build-corpus.mjs --refresh",
    "corpus:slice": "node scripts/build-corpus.mjs --max-names 20000",
    "bench": "node bench/dogfood.mjs",
    "bench:compare": "node bench/dogfood.mjs --compare",
    "bench:baseline": "node bench/dogfood.mjs --write-baseline",
    "bench:local": "node bench/dogfood.mjs --tier local",
    "bench:action-install": "node bench/action-install.mjs --compare",
    "bench:action-install:update-baseline": "node bench/action-install.mjs --write-baseline"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.0",
    "@vaultcompass/conductor": "0.4.0",
    "@vaultcompass/dep-guard": "0.4.0",
    "@vaultcompass/intent-guard": "1.4.0",
    "@vaultcompass/vault-guard": "1.7.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
